# Local runs only. In Google Cloud these come from Secret Manager.
GOOGLE_CLOUD_PROJECT=incident-to-fix
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# Required. GEMINI_FIX_MODEL falls back to GEMINI_MODEL when empty.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FIX_MODEL=gemini-3.8-flash
SNOW_INSTANCE_URL=https://dev492519.service-now.com
SNOW_USER=mcp.integration
SNOW_PASSWORD=
GITHUB_TOKEN=
TARGET_REPO=alokranjan04/incident-to-fix-demo
